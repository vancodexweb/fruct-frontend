{
	email {$ACME_EMAIL}
}

# The frontend — this stack's own service, same Docker network.
{$FRONTEND_DOMAIN} {
	reverse_proxy frontend:3000
}

# The backend's API — this Caddy instance now owns port 80/443 for the whole
# host, so it also proxies the backend's domain (the backend's own Caddy is
# stopped; see docker-compose.yml). Reaches `api` by container name on the
# backend's Docker network, which this stack joins as an external network.
{$BACKEND_DOMAIN} {
	reverse_proxy api:3001
}
