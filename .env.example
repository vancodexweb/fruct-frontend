# === App ===
# development | production
NODE_ENV=production
# Port the Next.js server listens on inside the container/host.
PORT=3000
# Interface the standalone server binds to. 0.0.0.0 is required in Docker so
# the healthcheck and Caddy (a different container) can reach it.
HOSTNAME=0.0.0.0

# === Backend API ===
# Base URL of the Fruct CRM NestJS backend, reachable from THIS server
# (never from the browser — the browser only ever talks to this frontend).
# - Local dev (backend run with `npm run start:dev` on the host): http://localhost:3001
# - Docker Compose: not actually read from here — docker-compose.yml hardcodes
#   API_URL to http://api:3001 (the backend's service name on the shared
#   Compose network) for the `frontend` service's environment, which always
#   wins over this file. Only relevant for `npm run dev`/`npm run start`
#   outside Docker.
API_URL=http://localhost:3001

# === Domains + SSL (Docker Compose deployment only) ===
# This stack runs its own Caddy, which takes over ports 80/443 for the whole
# host — see the big comment at the top of docker-compose.yml about stopping
# the backend's own Caddy first. Point both domains' DNS A/AAAA records at
# this server before deploying; Caddy issues each one its own Let's Encrypt
# certificate automatically on first request.

# The domain this frontend (this app) should be reachable at.
FRONTEND_DOMAIN=vancodex.tech

# The backend's own public domain — Caddy proxies it straight to the
# backend's `api` container (see deploy/Caddyfile), exactly as the backend's
# own Caddy did before it was stopped. Only used for the Caddy config, not
# by the frontend app itself (which reaches the API internally via API_URL).
BACKEND_DOMAIN=crm.vancodex.tech

# Email Let's Encrypt/ZeroSSL uses for certificate-expiry notices.
ACME_EMAIL=admin@vancodex.tech
